<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>java-review</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>java-review</name>
    <description>Java syntax review: lists, loops, streams, collections (interview prep)</description>

    <properties>
        <java.version>21</java.version>
        <jackson.version>2.23.0</jackson.version>
        <gson.version>2.15.0</gson.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- default class for `mvn exec:java`; override with -Dmain.class=review.loops.LoopPatterns -->
        <main.class>review.primitive.IntegerTypes</main.class>
    </properties>

    <dependencies>
        <!-- only lesson 17 (JSON output) needs these two -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <!-- keep parameter names for the reflection and record demos -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <!-- Do not wait 15 s for leftover daemon threads (executor and virtual-thread pools) after main returns -->
                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
